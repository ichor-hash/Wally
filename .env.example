# ---------------------------------------------------------------- language model
# groq (default) | openrouter | openai_compatible (Ollama, LM Studio, vLLM, ...)
LLM_PROVIDER=groq
GROQ_API_KEY=your_groq_api_key
# LLM_MODEL=openai/gpt-oss-120b      # or openai/gpt-oss-20b: faster and cheaper, a little less accurate
# OPENROUTER_API_KEY=
# LLM_BASE_URL=http://localhost:11434/v1     # openai_compatible only
# LLM_API_KEY=                               # openai_compatible only, if the server wants one

# ---------------------------------------------------------------- company
COMPANY_NAME=Acme Corp
ASSISTANT_NAME=Ethan
# Short background added to the system prompt (not a citable source)
COMPANY_PROFILE=

# ---------------------------------------------------------------- vector store (docs/HOSTING.md)
# Embedded, no server or Docker needed (single process):
QDRANT_PATH=./ethan_data/qdrant
# Or a Qdrant server / Qdrant Cloud (leave QDRANT_PATH empty):
# QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=
QDRANT_COLLECTION=ethan_docs

# ---------------------------------------------------------------- retrieval
RETRIEVAL_MODE=hybrid            # hybrid | dense | keyword
CHUNK_STRATEGY=structure         # structure | fixed
CONTEXTUAL_RETRIEVAL=header      # off | header (title + section, free) | llm (+ one summary call per document)

# ---------------------------------------------------------------- answer quality (docs/EVALUATION.md)
VERIFY_ANSWERS=true              # check every cited claim against its chunks (one extra call)
REVISE_ANSWERS=true              # rewrite once when a claim is unsupported, then check again
CORRECTIVE_RETRIEVAL=true        # rewrite and re-search the question when evidence is weak
# Agent tools (calculator, follow-up search) are switched on per user in Settings
CHUNK_SIZE=512
CHUNK_OVERLAP=50
EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
GAP_THRESHOLD=0.25

# ---------------------------------------------------------------- cost controls (docs/COSTS.md)
# Your provider's prices in USD per million tokens; 0 = free tier or local model
LLM_PRICE_INPUT_PER_M=0
LLM_PRICE_OUTPUT_PER_M=0
LLM_REASONING_EFFORT=low         # gpt-oss models: low | medium | high
LLM_TEMPERATURE=0.2
MAX_CONTEXT_CHARS=8000
MAX_OUTPUT_TOKENS=1024
ANSWER_CACHE_TTL=3600            # seconds; 0 disables the cache
ANSWER_CACHE_SIZE=256
CONTEXT_PRUNE_RATIO=0.01         # leave out chunks scoring below 1% of the best one; 0 sends all
# A smaller model for the fact-check and query rewrite (same provider and key); empty = LLM_MODEL
# CHECK_MODEL=openai/gpt-oss-20b
# CHECK_PRICE_INPUT_PER_M=0      # its prices; default to LLM_PRICE_*
# CHECK_PRICE_OUTPUT_PER_M=0

# ---------------------------------------------------------------- deployment
RATE_LIMIT=30                    # questions per minute per client
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
ALLOW_DIRECTORY_INGEST=false     # lets callers read server folders; trusted networks only
INNGEST_ENABLED=false            # pip install -r requirements-optional.txt first
# ETHAN_DATA_DIR=./ethan_data
